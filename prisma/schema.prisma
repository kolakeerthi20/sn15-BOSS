// ============================================================
// BOSS Platform — Production Prisma Schema
// PostgreSQL · Multi-tenant · Audit-ready
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// MULTI-TENANT ORGANIZATION
// ──────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  logoUrl     String?
  plan        OrgPlan  @default(STARTER)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users     User[]
  projects  Project[]
  teams     Team[]

  @@index([slug])
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ──────────────────────────────────────────
// USERS & AUTH
// ──────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  name           String
  avatar         String?
  passwordHash   String?
  role           UserRole  @default(EMPLOYEE)
  department     String?
  designation    String?
  billableRate   Decimal?  @db.Decimal(10, 2)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  managedProjects  Project[]         @relation("ProjectManager")
  projectMembers   ProjectMember[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  reportedTasks    Task[]            @relation("TaskReporter")
  dailyLogs        DailyLog[]
  comments         Comment[]
  notifications    Notification[]
  userSkills       UserSkill[]
  auditLogs        AuditLog[]
  timeEntries      TimeEntry[]

  @@unique([orgId, email])
  @@index([orgId, role])
  @@index([email])
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_LEAD
  EMPLOYEE
  CLIENT_VIEWER
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String
  skill     String
  level     SkillLevel @default(INTERMEDIATE)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ──────────────────────────────────────────
// PROJECTS
// ──────────────────────────────────────────

model Project {
  id                String        @id @default(cuid())
  orgId             String
  name              String
  description       String?       @db.Text
  client            String?
  managerId         String
  status            ProjectStatus @default(PLANNING)
  priority          Priority      @default(MEDIUM)
  startDate         DateTime
  endDate           DateTime
  budget            Decimal?      @db.Decimal(12, 2)
  spentBudget       Decimal       @default(0) @db.Decimal(12, 2)
  completionPercent Int           @default(0)
  healthScore       Int           @default(100)
  riskLevel         RiskLevel     @default(LOW)
  isArchived        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  manager     User            @relation("ProjectManager", fields: [managerId], references: [id])
  members     ProjectMember[]
  tasks       Task[]
  milestones  Milestone[]
  sprints     Sprint[]
  tags        ProjectTag[]
  dailyLogs   DailyLog[]
  comments    Comment[]
  auditLogs   AuditLog[]

  @@index([orgId, status])
  @@index([managerId])
  @@index([endDate])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProjectMember {
  id         String      @id @default(cuid())
  projectId  String
  userId     String
  role       MemberRole  @default(MEMBER)
  allocation Int         @default(100) // % of working time
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

enum MemberRole {
  LEAD
  MEMBER
  REVIEWER
  OBSERVER
}

model ProjectTag {
  id        String  @id @default(cuid())
  projectId String
  tag       String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tag])
}

// ──────────────────────────────────────────
// MILESTONES & SPRINTS
// ──────────────────────────────────────────

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  dueDate     DateTime
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, dueDate])
}

enum MilestoneStatus {
  PENDING
  COMPLETED
  MISSED
}

model Sprint {
  id        String       @id @default(cuid())
  projectId String
  name      String
  goal      String?      @db.Text
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNING)
  velocity  Int          @default(0)
  createdAt DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

// ──────────────────────────────────────────
// TASKS
// ──────────────────────────────────────────

model Task {
  id               String     @id @default(cuid())
  projectId        String
  milestoneId      String?
  sprintId         String?
  title            String
  description      String?    @db.Text
  assigneeId       String
  reporterId       String
  status           TaskStatus @default(NOT_STARTED)
  priority         Priority   @default(MEDIUM)
  startDate        DateTime?
  dueDate          DateTime?
  estimatedHours   Decimal    @default(0) @db.Decimal(8, 2)
  actualHours      Decimal    @default(0) @db.Decimal(8, 2)
  progressPercent  Int        @default(0)
  isRecurring      Boolean    @default(false)
  recurringPattern String?
  position         Int        @default(0) // for ordering in kanban
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   Milestone?      @relation(fields: [milestoneId], references: [id])
  sprint      Sprint?         @relation(fields: [sprintId], references: [id])
  assignee    User            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter    User            @relation("TaskReporter", fields: [reporterId], references: [id])
  subtasks    SubTask[]
  tags        TaskTag[]
  comments    Comment[]
  attachments Attachment[]
  dailyLogs   DailyLog[]
  timeEntries TimeEntry[]
  watchers    TaskWatcher[]
  auditLogs   AuditLog[]

  // Self-referential for dependencies
  blockedBy     TaskDependency[] @relation("DependentTask")
  blocking      TaskDependency[] @relation("DependencyTask")

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([sprintId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

model SubTask {
  id          String   @id @default(cuid())
  taskId      String
  title       String
  completed   Boolean  @default(false)
  assigneeId  String?
  position    Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  tag    String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, tag])
}

model TaskDependency {
  id            String @id @default(cuid())
  taskId        String
  dependsOnId   String

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model TaskWatcher {
  id     String @id @default(cuid())
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// ──────────────────────────────────────────
// DAILY WORK LOG
// ──────────────────────────────────────────

model DailyLog {
  id                  String    @id @default(cuid())
  userId              String
  projectId           String
  taskId              String?
  date                DateTime  @db.Date
  status              LogStatus @default(IN_PROGRESS)
  summary             String    @db.Text
  hoursWorked         Decimal   @default(0) @db.Decimal(5, 2)
  blockers            String?   @db.Text
  tomorrowPlan        String?   @db.Text
  progressPercent     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId], references: [id])
  task        Task?        @relation(fields: [taskId], references: [id])
  deliverables LogDeliverable[]
  attachments  Attachment[]

  @@unique([userId, projectId, date])
  @@index([userId, date])
  @@index([projectId, date])
}

enum LogStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

model LogDeliverable {
  id       String   @id @default(cuid())
  logId    String
  title    String
  log      DailyLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────
// TIME TRACKING
// ──────────────────────────────────────────

model TimeEntry {
  id          String    @id @default(cuid())
  userId      String
  taskId      String
  startedAt   DateTime
  endedAt     DateTime?
  hours       Decimal   @default(0) @db.Decimal(8, 2)
  isBillable  Boolean   @default(true)
  description String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([taskId])
}

// ──────────────────────────────────────────
// COLLABORATION
// ──────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  taskId    String?
  projectId String?
  parentId  String?  // for threaded replies
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task     Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id])
  mentions Mention[]
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([taskId])
  @@index([projectId])
  @@index([authorId])
}

model Mention {
  id        String  @id @default(cuid())
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model Attachment {
  id           String   @id @default(cuid())
  name         String
  url          String
  size         Int
  mimeType     String
  uploadedById String
  taskId       String?
  logId        String?
  createdAt    DateTime @default(now())

  task    Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  log     DailyLog? @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ──────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String           @db.Text
  link       String?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  TASK_ASSIGNED
  COMMENT_MENTION
  TASK_OVERDUE
  DAILY_LOG_REMINDER
  PROJECT_UPDATE
  BLOCKER_ESCALATION
  APPROVAL_NEEDED
  STATUS_CHANGED
  DEADLINE_APPROACHING
}

// ──────────────────────────────────────────
// AUTOMATIONS
// ──────────────────────────────────────────

model AutomationRule {
  id          String   @id @default(cuid())
  orgId       String
  projectId   String?
  name        String
  trigger     String   // e.g. "task.status.changed"
  conditions  Json     // JSON condition object
  actions     Json     // JSON action object
  isActive    Boolean  @default(true)
  lastTriggeredAt DateTime?
  triggerCount    Int  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, isActive])
  @@index([projectId])
}

// ──────────────────────────────────────────
// TEAMS
// ──────────────────────────────────────────

model Team {
  id      String @id @default(cuid())
  orgId   String
  name    String
  leadId  String?
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ──────────────────────────────────────────
// AUDIT LOG — Event Sourcing
// ──────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  taskId     String?
  action     String   // e.g. "task.status.changed"
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}
